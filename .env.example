# Server Configuration
PORT=3001
NODE_ENV=production

# JWT Secret (change this to a random string!)
JWT_SECRET=your-secret-key-change-me

# Admin credentials (used on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Application URL (used in emails)
APP_URL=http://localhost:3001

# SMTP Configuration (optional - for sending welcome emails)
# If not configured, passwords will only be shown in the admin panel
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@example.com

# Default License Settings
# Plan options: full, einzel, pairs
DEFAULT_LICENSE_PLAN=full
# License duration in days (0 = unlimited)
DEFAULT_LICENSE_DAYS=0
